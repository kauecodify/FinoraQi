# Copie para .env e ajuste. Nunca versione o arquivo .env.
ENV=development

# Banco: SQLite local por padrão; no docker-compose a URL do PostgreSQL é injetada automaticamente.
DATABASE_URL=sqlite:///./finoraqi.db
AUTO_CREATE_TABLES=true

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Lista JSON de origens permitidas
CORS_ORIGINS=["http://localhost:8000","http://localhost:8080"]

MODELS_DIR=./models_store
MAX_UPLOAD_MB=20

# static (taxas de referência embutidas) ou http (BCE via frankfurter.app com fallback estático)
FX_PROVIDER=static

POSTGRES_USER=finoraqi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finoraqi
